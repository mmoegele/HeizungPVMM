[Unit]
Description=Heizungssteuerung Service
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
Restart=always
RestartSec=1
User=pi
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/home/pi/Documents/HeizungPVMM
ExecStart=/home/pi/Documents/HeizungPVMM/.venv/bin/python3 main.py
# Ensure systemd captures all output to journal
StandardOutput=journal
StandardError=journal
# Use structured logging for better journal integration
SyslogIdentifier=heating-control

[Install]
WantedBy=multi-user.target